# Files to include in / exclude from the source distribution
# ソース配布物 (sdist) に含める / 含めないファイル

include LICENSE
include README.md
include README.ja.md
include CHANGELOG.md
include CHANGELOG.ja.md

# Cython sources are needed to rebuild the extensions from the sdist
# sdist から拡張モジュールを再ビルドするために Cython のソースが必要
recursive-include lpu *.pxd *.pyx

# The PEP 561 marker, so that type checkers recognize the annotations
# 型チェッカーが注釈を認識できるよう PEP 561 のマーカーファイルを含める
include lpu/py.typed

# The test suite, so that downstream packagers can run it
# 再配布者がテストを実行できるようにテストスイートも含める
recursive-include tests *.py

# Generated and built artifacts must not be shipped. The .cpp files are
# regenerated by cythonize at build time, and shipping a stale copy would
# only add weight and confusion.
# 生成物・ビルド成果物は配布しない。.cpp はビルド時に cythonize が
# 再生成するため、古い写しを同梱しても無駄と混乱を招くだけである。
global-exclude *.c
global-exclude *.cpp
global-exclude *.so
global-exclude *.pyc
prune **/__pycache__
